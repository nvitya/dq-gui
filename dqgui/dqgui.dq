
use dqgui/ddgfx/openglutils
use dqgui/ddgfx/ddgfx
use ./widget

var gui_initialized : bool = false

object EGuiUse(Exception):
endobject

object OWindow(OWidget):
    m_title : str
    scene   : ODdScene

    m_handle : pointer

    func *Create(awidth : int, aheight : int, atitle : rostr) ..
    func *Destroy() ..
    func Show() ..
    func Hide() ..
    func Draw() ..
    func ShouldClose() -> bool ..
    func PollEvents() ..

    func OnRefresh()  [[virtual]]:  endfunc
    func OnResize(awidth : int32, aheight : int32)  [[virtual]]:  endfunc
    func OnMouseMove(ax : float64, ay : float64)  [[virtual]]:  endfunc
    func OnMouseButton(button : int32, action : int32, mods : int32)  [[virtual]]:  endfunc
    func OnFocus(afocused : bool)  [[virtual]]:  endfunc
    func OnKey(key : int32, scancode : int32, action : int32, mods : int32)  [[virtual]]:  endfunc
    func OnChar(codepoint : uint32)  [[virtual]]:  endfunc
endobject

object OGuiApp:
    initialized : bool = false
    winlist     : [*]OWindow

    shared_ctx_win : TGlfwWindow

    func *Create() ..
    func *Destroy() ..

    func Init() ..
    func Terminate() ..
    func Run() ..
    func AddWindow(win : OWindow) ..
    func RemoveWindow(win : OWindow) ..
endobject

var gui_app : OGuiApp

implementation

func *ModuleInit():
    gui_app = new OGuiApp()
endfunc

//-----------------------------------------------------------------------------

func OWinFromGlfw(window : TGlfwWindow) -> OWindow  [[inline]]:
    result = OWindow(GlfwGetWindowUserPointer(window))
endfunc

func GlfwCbWindowRefresh(window : TGlfwWindow):
    var w :? = OWinFromGlfw(window)
    w.OnRefresh()
endfunc

func GlfwCbResize(window : TGlfwWindow, width : int32, height : int32):
    var w :? = OWinFromGlfw(window)
    w.OnResize(width, height)
endfunc

func GlfwCbMouseMove(window : TGlfwWindow, x : float64, y : float64):
    var w :? = OWinFromGlfw(window)
    w.OnMouseMove(x, y)
endfunc

func GlfwCbMouseButton(window : TGlfwWindow, button : int32, action : int32, mods : int32):
    var w :? = OWinFromGlfw(window)
    w.OnMouseButton(button, action, mods)
endfunc

func GlfwCbWindowFocus(window : TGlfwWindow, focused : int32):
    var w :? = OWinFromGlfw(window)
    w.OnFocus(focused == GLFW_TRUE)
endfunc

func GlfwCbKey(window : TGlfwWindow, key : int32, scancode : int32, action : int32, mods : int32):
    var w :? = OWinFromGlfw(window)
    w.OnKey(key, scancode, action, mods)
endfunc

func GlfwCbChar(window : TGlfwWindow, codepoint : uint32):
    var w :? = OWinFromGlfw(window)
    w.OnChar(codepoint)
endfunc


func OWindow.*Create(awidth : int, aheight : int, atitle : rostr):
    inherited Create(nil)
    m_title = atitle
    width  = awidth
    height = aheight

    scene = new ODdScene()
    scene.background = {0.2, 0.2, 0.2, 1.0}
    //scene.root.AddChild(self) // must be removed
endfunc

func OWindow.*Destroy():
    Hide()
    scene.root.RemoveChild(self)  // remove self first, otherwise the scene destroy will delete self
    delete scene
    inherited Destroy()
endfunc

func OWindow.Show():
    use *
    if m_handle <> nil:
        return
    endif

    gui_app.Init()  // checks if already initialized

    m_handle = GlfwCreateWindow(Round(width), Round(height), m_title.pchar, nil, gui_app.shared_ctx_win)
    if m_handle == nil:
        raise EOpenGl('Could not create the OpenGL window')
    endif

    GlfwMakeContextCurrent(m_handle)
    GlfwSwapInterval(1)

    // register the self object for the callbacks
    GlfwSetWindowUserPointer(m_handle, pointer(self))

    GlfwSetWindowRefreshCallback(m_handle, GlfwCbWindowRefresh)
    GlfwSetFramebufferSizeCallback(m_handle, GlfwCbResize)
    GlfwSetCursorPosCallback(m_handle, GlfwCbMouseMove)
    GlfwSetMouseButtonCallback(m_handle, GlfwCbMouseButton)
    GlfwSetWindowFocusCallback(m_handle, GlfwCbWindowFocus)
    GlfwSetKeyCallback(m_handle, GlfwCbKey)
    GlfwSetCharCallback(m_handle,GlfwCbChar)

    gui_app.AddWindow(self)
endfunc

func OWindow.Hide():
    if m_handle <> nil:
        @.GlfwDestroyWindow(m_handle)
        m_handle = nil
    endif

    @.gui_app.RemoveWindow(self)
endfunc

func OWindow.Draw():
    use openglutils
    if m_handle == nil:
        raise EGuiUse('Drawing invisible window, call Show() first')
    endif

    GlfwMakeContextCurrent(m_handle)

    var width  : int32 = 0
    var height : int32 = 0
    GlfwGetFramebufferSize(m_handle, %width, %height)

    scene.BeginFrame(width, height)  // calls draws
    scene.EndFrame(m_handle)         // calls swap, might block
endfunc

func OWindow.ShouldClose() -> bool:
    if m_handle == nil:
        raise EGuiUse('Windows is not visible, call Show() first')
    endif
    return @.GlfwWindowShouldClose(m_handle) <> @.GLFW_FALSE
endfunc

func OWindow.PollEvents():
    @.GlfwPollEvents()
endfunc

//-----------------------------------------------------------------------------

func OGuiApp.*Create():

endfunc

func OGuiApp.*Destroy():

endfunc

func OGuiApp.Init():
    use openglutils

    if initialized:
        return
    endif

    if GlfwInit() == GLFW_FALSE:
        raise EOpenGl('Could not initialize GLFW')
    endif

    // DdGfx uses shaders, vertex-array objects, and vertex buffers.  A
    // compatibility profile keeps the legacy GL_ALPHA text texture format.
    GlfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 3)
    GlfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 3)
    GlfwWindowHint(GLFW_OPENGL_PROFILE, GLFW_OPENGL_COMPAT_PROFILE)

    // create an invisible window for context sharing
    GlfwWindowHint(GLFW_VISIBLE, GLFW_FALSE)
    shared_ctx_win = GlfwCreateWindow(1, 1, 'dqgui-share', nil, nil)
    if shared_ctx_win == nil:
        raise EOpenGl('Could not create OpenGL share context')
    endif

    GlfwMakeContextCurrent(shared_ctx_win)

    // Restore the default for subsequently created application windows.
    GlfwWindowHint(GLFW_VISIBLE, GLFW_TRUE)

    initialized = true
endfunc

func OGuiApp.AddWindow(win : OWindow):
    if not initialized:
        Init()
    endif
    if winlist.IndexOf(win) < 0:
        winlist.Append(win)
    endif
endfunc

func OGuiApp.RemoveWindow(win : OWindow):
    if not initialized:
        Init()
    endif
    var i : int = winlist.IndexOf(win)
    if i >= 0:
        winlist.Delete(i)
    endif
endfunc

func OGuiApp.Terminate():
    if not initialized:
        return
    endif

    for w :? in winlist:
        w.Hide()
    endfor

    if shared_ctx_win <> nil:
        @.GlfwDestroyWindow(shared_ctx_win)
        shared_ctx_win = nil
    endif

    @.GlfwTerminate()
    initialized = false
endfunc

func OGuiApp.Run():
    use openglutils
    while true:
        GlfwPollEvents()

        var i : int = 0
        while i < winlist.length:
            var w : OWindow = winlist[i]
            if w.ShouldClose():
                w.Hide()  // this removes from the winlist !
            else:
                w.Draw()
                i += 1
            endif
        endwhile

        if winlist.length <= 0:
            break
        endif

        GlfwWaitEventsTimeout(0.250)
    endwhile

    Terminate()
endfunc
