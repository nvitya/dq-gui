object OMainWindow(OWindow):
    func OnResize(awidth : int32, aheight : int32)  [[override]]:
        @.PrintLn('Resize: {}, {}', [awidth, aheight])
    endfunc

    func OnKey(key : int32, scancode : int32, action : int32, mods : int32)  [[override]]:
        @.PrintLn('OnKey: key={}, scancode={}, action={}, mods={}', [key, scancode, action, mods])
    endfunc

    func OnChar(codepoint : uint32)  [[override]]:
        @.PrintLn('OnChar: codepoint={:x}, char="{}"', [codepoint, @.StrFromWchars([wchar(codepoint)])])
    endfunc

    func OnMouseMove(ax : float64, ay : float64)  [[override]]:
        //@.PrintLn('MouseMove: {}, {}', [ax, ay])
    endfunc
endobject

object OSecondWindow(OWindow):

endobject


//-----------------------------------------------------------------------------

func *Main():
    PrintLn('DQGUI Layout Test')

    var win = new OMainWindow(800, 600, 'DQGUI Layout Test')
    win.Show()

    var win2 = new OSecondWindow(400, 300, 'Second Window')
    win2.Show()

    gui_app.Run()

/*
    while not win.ShouldClose():
