// GLFW version of /workvc/ddgfx/tests/test1/formmain.pas.
// It demonstrates an original shape, three cloned shapes, and three cloned
// groups animated independently within a DdGfx scene.

use print
use math
use dqgui/ddgfx/openglutils
use dqgui/ddgfx/ddgfx
use dqgui

const original_width  : int = 800
const original_height : int = 600

//-----------------------------------------------------------------------------

object OWidgetFrame(ODrawGroup):
protected
    rectverts : [4]SDdVertex
    rectshape : OShape
    rectoutl  : OShape
public

    scale : float32 = 1.0
    w     : float32 = 1
    h     : float32 = 1

    func *Create(parent : ODrawable):
        inherited Create(parent)

        rectverts = [ {0, 0}, {1, 0}, {1, 1}, {0, 1} ]

        rectshape = new OShape(self)
        rectshape.AddPrimitive(@.GL_TRIANGLE_FAN, rectverts)
        rectshape.alpha = 0.3

        rectoutl = new OShape(self)
        rectoutl.AddPrimitive(@.GL_LINE_LOOP, rectverts)
        rectoutl.color = {1.0, 0.0, 0.0, 1.0}
    endfunc
endobject

object OMainWindow(OWindow):
    wf1 : OWidgetFrame
    wf2 : OWidgetFrame

    rectverts : [4]SDdVertex
    rectshape : OShape

    original_shape : OShape
    original_group : ODrawGroup
    group_clones   : [*]OClonedGroup
    triangle : [3]SDdVertex


    func *Create(awidth : int, aheight : int, atitle : rostr):
        use *

        inherited Create(awidth, aheight, atitle)

        triangle = [ {0,0}, {1, 0}, {1,1} ]

        original_shape = new OShape(nil)
        original_shape.AddPrimitive(GL_TRIANGLES, triangle)
        original_shape.scalex = 100
        original_shape.scaley = 100
        original_shape.alpha = 0.5
        original_shape.color = {1.0, 0.0, 0.0, 1.0}

        original_group = new ODrawGroup(nil)
        original_group.CloneShape(original_shape)

        var clone_shape : OClonedShape
        clone_shape = original_group.CloneShape(original_shape)
        clone_shape.x += 50
        clone_shape.rotation = 20
        clone_shape.color = {0.0, 1.0, 0.0, 0.4}

        clone_shape = original_group.CloneShape(original_shape)
        clone_shape.x += 70
        clone_shape.rotation = 30
        clone_shape.color = {0.0, 0.0, 1.0, 0.4}

        var clone_group : OClonedGroup
        clone_group = scene.root.CloneGroup(original_group)
        clone_group.x = 100
        clone_group.y = 100
        group_clones.Append(clone_group)

        clone_group = scene.root.CloneGroup(original_group)
        clone_group.x = 200
        clone_group.y = 150
        clone_group.alpha = 0.5
        group_clones.Append(clone_group)

        clone_group = scene.root.CloneGroup(original_group)
        clone_group.x = 300
        clone_group.y = 170
        clone_group.alpha = 0.3
        group_clones.Append(clone_group)

        //wf1 = new OWidgetFrame(scene.root)
        //wf1.x = 10
        //wf1.y = 10
        //wf1.scalex = 200
        //wf1.scaley = 50
        //wf1.color = {1.0, 0.0, 0.0, 0.4}

        //wf2 = new OWidgetFrame(self)
        //wf2.x = 400
        //wf2.y = 10
        //wf2.scalex = 300
        //wf2.scaley = 50
    endfunc

    func OnResize(awidth : int32, aheight : int32)  [[override]]:
        @.PrintLn('Resize: {}, {}', [awidth, aheight])
    endfunc

    func OnKey(key : int32, scancode : int32, action : int32, mods : int32)  [[override]]:
        @.PrintLn('OnKey: key={}, scancode={}, action={}, mods={}', [key, scancode, action, mods])
    endfunc

    func OnChar(codepoint : uint32)  [[override]]:
        @.PrintLn('OnChar: codepoint={:x}, char="{}"', [codepoint, @.StrFromWchars([wchar(codepoint)])])
    endfunc

    func OnMouseMove(ax : float64, ay : float64)  [[override]]:
        //@.PrintLn('MouseMove: {}, {}', [ax, ay])
    endfunc
endobject

object OSecondWindow(OWindow):

endobject

//-----------------------------------------------------------------------------

func *Main():
    PrintLn('DQGUI Layout Test')

    gui_app.Init()

    var win = new OMainWindow(800, 600, 'DQGUI Layout Test')
    win.Show()

    gui_app.Run()
endfunc
